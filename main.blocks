<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="6=4xP!SF]/|7T*6HbI5w" x="0" y="0"><statement name="HANDLER"><block type="game_show_long_text" id="a8mvxM@iswf}GiPH:gp)"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="aeXq?1`RUvcp4:^r?!=x"><field name="TEXT">1976, San Rafael Mendoza. Aldo López Rodruigez descubre que la municipalidad es una organización secreta criminal. Cometían secuestros, torturas, asesinatos, corrupción, entre otras cosas. Su misión es erradicar a todos los criminales y rescatar a toda la gente que esté ahí. </field></shadow></value></block></statement></block></xml>